    [ @file = "/Users/ja-ais-mac/Documents/Projects/aracer-xtune-re/garmin/MotoTuneRide/source/RideView.mc"; @line = 449; @symbol_functiondef = [drawRide,449,21,29]; @symbol_param<0> = [dc,449,30,32]; @symbol_param<0>_type<0> = [Dc,449,36,38]; @symbol_param<1> = [now,449,40,43]; @symbol_param<1>_type<0> = [Number,449,47,53]; ]
